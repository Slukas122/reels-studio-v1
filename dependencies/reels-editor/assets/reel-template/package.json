{
  "name": "auto-reel-project",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "sideEffects": ["*.css"],
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "lint": "eslint src && tsc --noEmit",
    "render": "remotion render src/index.ts Reel outputs/reel-raw.mp4 --codec=h264 --pixel-format=yuv420p --audio-codec=aac",
    "still": "remotion still src/index.ts Reel",
    "finish": "node tools/finish.mjs",
    "transcribe": "node tools/transcribe.mjs",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/captions": "4.0.527",
    "@remotion/cli": "4.0.527",
    "@remotion/install-whisper-cpp": "4.0.527",
    "@remotion/media": "4.0.527",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.527"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.527",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
